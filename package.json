{
  "name": "repo-sdp",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "nx run-many -t dev",
    "dev:web": "nx run @sdp/web:dev",
    "dev:api": "nx run @sdp/api:dev",
    "build": "nx run-many -t build",
    "build:web": "nx run @sdp/web:build",
    "build:api": "nx run @sdp/api:build",
    "test": "nx run-many -t test",
    "test:web": "nx run @sdp/web:test",
    "test:api": "nx run @sdp/api:test",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint -- --fix",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "nx run @sdp/web-e2e:e2e",
    "graph": "nx graph",
    "prepare": "husky"
  },
  "dependencies": {

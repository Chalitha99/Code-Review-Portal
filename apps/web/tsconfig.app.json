{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",

    /*
     * Path aliases — must mirror `resolve.alias` in vite.config.ts.
     * No `baseUrl`: it is deprecated in TypeScript 6, and without it these
     * targets resolve relative to this file, which is what we want anyway.
     */
    "paths": {
      "@/*": ["./src/*"],
      "@tests/*": ["./tests/*"],
      "@sdp/contracts": ["../../packages/contracts/src/index.ts"],
      "@sdp/types": ["../../packages/types/src/index.ts"]
    }
  },
  "include": ["src", "tests", "../../packages/*/src"]
}
